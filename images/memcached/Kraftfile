spec: v0.6

name: memcached

runtime: index.unikraft.io/official/base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs: ./Dockerfile

# The unikernel runs as root; memcached refuses to start as root without -u.
# No -l: memcached sets IPV6_V6ONLY on its IPv6 sockets, so a single address
# would serve one family only. With the default it binds both :: and 0.0.0.0
# and starts as long as one succeeds; Datum compute networks are IPv6-only.
cmd: ["/usr/bin/memcached", "-u", "root", "-p", "11211"]
