spec: v0.6

name: caddy

# Caddy is built as a static PIE, so it runs on the plain elfloader runtime
# with no dynamic loader or shared libraries in the rootfs.
runtime: index.unikraft.io/official/base:latest

targets:
  - kraftcloud/x86_64

rootfs: ./Dockerfile

cmd: ["/usr/bin/caddy", "run", "--config", "/etc/caddy/Caddyfile"]
