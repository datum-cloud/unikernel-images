spec: v0.6

name: nginx

# nginx is a dynamically linked glibc binary, so it needs the binary-compatible
# runtime that ships a dynamic loader (the enterprise elfloader image that
# Datum cells boot).
runtime: index.unikraft.io/official/base-compat:latest

targets:
  - kraftcloud/x86_64

rootfs: ./Dockerfile

cmd: ["/usr/bin/nginx", "-c", "/etc/nginx/nginx.conf"]
